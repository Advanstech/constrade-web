-- KYC application state for the broker-dealer onboarding wizard
create table if not exists cc.kyc (
  user_id uuid primary key references auth.users(id) on delete cascade,
  data jsonb not null default '{}'::jsonb,
  completed_steps int not null default 0,
  status text not null default 'in_progress' check (status in ('in_progress','submitted','approved')),
  created_at timestamptz not null default now(),
  updated_at timestamptz not null default now()
);

create index if not exists idx_cc_kyc_status on cc.kyc(status);

alter table cc.kyc enable row level security;

create policy "Users read own kyc" on cc.kyc
  for select using (auth.uid() = user_id);
create policy "Users update own kyc" on cc.kyc
  for update using (auth.uid() = user_id);
create policy "Staff read all kyc" on cc.kyc
  for select using (
    exists (select 1 from cc.profiles p where p.user_id = auth.uid() and p.role in ('admin','compliance','trader'))
  );

-- default privileges on new cc tables for the API roles
notify pgrst, 'reload schema';